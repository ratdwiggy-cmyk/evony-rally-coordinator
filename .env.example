# -----------------------------------------------------------------------------
# Firebase client configuration, per PROJECT_SPECIFICATION.md section 6/7 and
# DATABASE_SETUP.md. These values are safe to expose client-side (Firebase's
# client config is public by design); real access control lives in Firestore
# Security Rules (firestore.rules), not in keeping these secret.
# Copy this file to `.env.local` and fill in real values from your Firebase
# project's Web app config (Project settings → General → Your apps).
# -----------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" (or leave unset) to silently fall back to the unconfigured
# foundation-mode UI when Firebase config is missing, instead of throwing.
# Set to "false" to make a missing/misconfigured .env.local fail loudly.
VITE_FIREBASE_OPTIONAL=true
